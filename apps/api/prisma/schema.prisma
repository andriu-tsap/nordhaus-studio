generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model User {
 id String @id @default(cuid())
 email String @unique
 password String
 role String @default("client")
 refreshTokens RefreshToken[]
}
model RefreshToken {
 id String @id @default(cuid())
 hash String @unique
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 expiresAt DateTime
}
model Lead {
 id String @id @default(cuid())
 name String
 email String
 message String
 stage String @default("Nowy")
 value Int @default(0)
 source String @default("Formularz")
 configuration Json?
 createdAt DateTime @default(now())
 @@index([email])
}
model Booking {
 id String @id @default(cuid())
 employee String
 start DateTime
 name String
 email String
 createdAt DateTime @default(now())
 @@unique([employee,start])
}
model Order {
 id String @id @default(cuid())
 email String
 items Json
 total Int
 status String @default("pending")
 stripeId String? @unique
 createdAt DateTime @default(now())
}
model Setting {
 key String @id
 value Json
}
model Outbox {
 id String @id @default(cuid())
 to String
 subject String
 text String
 configuration Json?
 attempts Int @default(0)
 sentAt DateTime?
 createdAt DateTime @default(now())
}
